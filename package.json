{
  "name": "wake-game",
  "version": "1.0.0",
  "private": true,
  "description": "修仙：挂机觉醒 - 次神风格挂机卡牌游戏（Cloudflare 全栈）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy public --project-name=wake-game",
    "db:migrate:local": "wrangler d1 migrations apply wake-game-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wake-game-db --remote",
    "db:seed:local": "wrangler d1 execute wake-game-db --local --file=workers/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute wake-game-db --remote --file=workers/db/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0",
    "vue": "^3.5.12",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "hono": "^4.6.5"
  }
}
